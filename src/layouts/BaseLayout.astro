---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { SITE_URL } from "../config/site";
import SearchOverlay from "../components/SearchOverlay.astro";

const {
  title = "KIPROD",
  description = "KIPROD strengthens credit risk governance, capability development, and operational execution across financial institutions—from insight to capability to execution.",
  activePath = "/",
  canonicalPath,
  articleDate,
} = Astro.props;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, SITE_URL).href;
const deploymentEnvironment = process.env.VERCEL_ENV;
const isPreview = import.meta.env.DEV ||
  (deploymentEnvironment !== undefined && deploymentEnvironment !== "production");
const isPrivatePath = /^\/(admin|login|auth|account|dashboard|preview|staging|private)(\/|$)/i.test(Astro.url.pathname);
const noindex = isPreview || isPrivatePath;
const socialImage = `${SITE_URL}/assets/kiprod-logo-lockup.png`;
const organizationId = `${SITE_URL}/#organization`;
const websiteId = `${SITE_URL}/#website`;
const graph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": organizationId,
    name: "KIPROD Risk Management Services Ltd",
    url: SITE_URL,
    logo: `${SITE_URL}/assets/kiprod-logo-2026.png`,
    description: "Institutional strengthening, credit risk management, capability development and advisory support for financial institutions."
  },
  {
    "@type": "WebSite",
    "@id": websiteId,
    name: "KIPROD",
    url: SITE_URL,
    publisher: { "@id": organizationId }
  },
  {
    "@type": "WebPage",
    "@id": canonical,
    url: canonical,
    name: title,
    description,
    isPartOf: { "@id": websiteId }
  }
];
if (articleDate) {
  graph.push({
    "@type": "Article",
    "@id": `${canonical}#article`,
    headline: title.replace(/\s+[–-]\s+KIPROD$/, ""),
    description,
    datePublished: articleDate,
    mainEntityOfPage: { "@id": canonical },
    publisher: { "@id": organizationId }
  });
}
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0A2740" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow, noarchive" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:locale" content="en_KE" />
    <meta property="og:site_name" content="KIPROD" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="KIPROD logo" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="KIPROD logo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/assets/kiprod-logo-2026.png" />
    <link rel="apple-touch-icon" href="/assets/kiprod-logo-2026.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Nav activePath={activePath} />

    <SearchOverlay />
    <a href="#main-content" class="skip-link">
Skip to content
</a>

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script>
  (function () {
    // Reveal animations
    const reveals = document.querySelectorAll('.reveal');

    if (reveals.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );

      reveals.forEach((el) => observer.observe(el));
    }

    // Navbar shadow on scroll
    const nav = document.querySelector('nav');

    if (nav) {
      window.addEventListener('scroll', () => {
        nav.classList.toggle("nav-scrolled", window.scrollY > 40);
      });
    }

    // Mobile menu toggle
    const toggle = document.querySelector('.nav-toggle');
    const menu = document.querySelector('.mobile-menu');

    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        const isOpen = menu.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(isOpen));
      });

      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          menu.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
        });
      });
    }
  })();
</script>
  </body>
</html>