---
import type { CollectionEntry } from "astro:content";
import { insightSlug, topicLabel } from "../lib/insights";

interface Props {
  posts: CollectionEntry<"insights">[];
  columns?: 2 | 3;
  showTopic?: boolean;
}

const { posts, columns = 2, showTopic = true } = Astro.props;
---

<div class={`download-grid insight-grid insight-grid--${columns}`}>
  {
    posts.map((post) => (
      <div class="download-card reveal">
        <div class="pill">
          {showTopic ? topicLabel(post.data.topic) : post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" })}
        </div>
        <div class="download-title">{post.data.title}</div>
        <div class="download-desc">{post.data.description}</div>
        <a class="arm-link" href={`/insights/${insightSlug(post)}`}>Read insight →</a>
      </div>
    ))
  }
</div>

<style>
  .insight-grid.insight-grid--3 { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; background:transparent; margin-top:18px; }
  .insight-grid .download-card { display:flex; flex-direction:column; min-width:0; padding:24px 22px; border:1px solid rgba(9,34,74,.1); }
  .insight-grid .download-card .arm-link { margin-top:auto; padding-top:12px; }
  @media (max-width:900px) { .insight-grid.insight-grid--3 { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (max-width:600px) { .insight-grid.insight-grid--3 { grid-template-columns:1fr !important; } }
</style>
