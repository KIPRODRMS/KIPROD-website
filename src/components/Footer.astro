---
const links = [
  { href: "/", label: "Home" },
  { href: "/#approach", label: "Methodology" },
  { href: "/institute", label: "Institute" },
  { href: "/academy", label: "Academy" },
  { href: "/partnerships", label: "RMS" },
  { href: "/command-centre", label: "Command Centre" },
  { href: "/insights", label: "Insights" },
  { href: "/resources", label: "Resources" },
  { href: "/media", label: "Media Centre" },
  { href: "/partners", label: "Partners" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<footer>

  <div class="footer-inner">

    <div class="footer-top">

      <div class="footer-brand-block">

        <div class="footer-brand-logo">
          <img
            src="/assets/kiprod-logo-2026.png"
            alt="KIPROD"
            class="brand-logo-img"
          />
        </div>

        <div class="footer-brand-desc">
          KIPROD is an institutional strengthening firm helping financial
          institutions move from insight through capability development and
          execution into continuous improvement.<br /><br />
          Its Institute, Academy, RMS and Command Centre form one integrated
          institutional strengthening ecosystem.
        </div>

      </div>


      <div>

        <div class="footer-col-title">
          Explore
        </div>

        <ul class="footer-links compact-links">
          {links.map((l) => (
            <li>
              <a href={l.href}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>

      </div>


      <div>

        <div class="footer-col-title">
          Client Journey
        </div>

        <div class="footer-journey footer-journey-simple">
          <span>Discover</span>
          <span>Develop</span>
          <span>Sustain</span>
        </div>

        <div class="footer-col-title institution-title">
          Institution Types
        </div>

        <div class="footer-badges">
          <span>Banks</span>
          <span>SACCOs</span>
          <span>Microfinance</span>
          <span>Credit Providers</span>
          <span>Government</span>
          <span>Regulators</span>
          <span>DFIs</span>
          <span>Co-operatives</span>
        </div>

      </div>

    </div>


    <div class="footer-cta-compact">

      <div>
        <h3>
          Ready to Begin Your Institutional Journey?
        </h3>

        <p>
          Begin by understanding your institution’s priorities, capability
          gaps and operational realities.
        </p>
      </div>

      <a href="/contact?assessment=ilca" class="btn-primary">
        Start Your Institutional Assessment →
      </a>

    </div>


    <div class="footer-bottom">

      <div class="footer-copy">
        © 2026 KIPROD Risk Management Services Ltd. All Rights Reserved.
      </div>

      <div class="footer-markets">
        Governance • Capability • Executive Learning • Implementation • Institutional Intelligence
      </div>

    </div>

  </div>

</footer>


<style>

  footer {
    padding: 42px 32px 24px;
  }

  .footer-inner {
    max-width: 1180px;
    margin: auto;
    padding: 0;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.25fr 1fr 1fr;
    gap: 36px;
    padding-bottom: 26px;
    margin-bottom: 0;
    border-bottom: 1px solid rgba(255,255,255,.09);
  }

  .footer-brand-logo {
    margin-bottom: 12px;
  }

  .footer-brand-desc {
    max-width: 390px;
    margin: 0;
    color: rgba(255,255,255,.74);
    font-size: .82rem;
    line-height: 1.6;
  }

  .footer-col-title {
    margin-bottom: 14px;
    padding-bottom: 9px;
    color: var(--white);
  }

  .footer-col-title::after {
    width: 34px;
  }

  .compact-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0,1fr));
    gap: 7px 18px;
  }

  .footer-links a {
    color: rgba(255,255,255,.72);
    font-size: .78rem;
  }

  .footer-journey-simple,
  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    align-items: flex-start;
  }

  .footer-journey-simple span,
  .footer-badges span {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    margin: 0;
    padding: 5px 7px;
    border: 1px solid rgba(255,255,255,.11);
    color: rgba(255,255,255,.78);
    font-size: .68rem;
  }

  .institution-title {
    margin-top: 22px;
  }

  .footer-cta-compact {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 30px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid rgba(255,255,255,.09);
  }

  .footer-cta-compact h3 {
    margin: 0 0 6px;
    color: var(--white);
    font: 600 1.35rem/1.2 var(--font-display);
  }

  .footer-cta-compact p {
    max-width: 680px;
    margin: 0;
    color: rgba(255,255,255,.68);
    font-size: .79rem;
    line-height: 1.55;
  }

  .footer-bottom {
    gap: 30px;
    padding-top: 20px;
  }

  .footer-copy,
  .footer-markets {
    font-size: .72rem;
  }

  @media (max-width: 900px) {

    footer {
      padding: 38px 24px 22px;
    }

    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }

    .footer-brand-block {
      grid-column: 1 / -1;
    }

    .footer-cta-compact {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .footer-cta-compact .btn-primary {
      width: fit-content;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .footer-markets {
      text-align: left;
    }

  }

  @media (max-width: 600px) {

    footer {
      padding: 34px 18px 20px;
    }

    .footer-top {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .compact-links {
      grid-template-columns: repeat(2, minmax(0,1fr));
    }

    .footer-cta-compact .btn-primary {
      width: 100%;
      text-align: center;
    }

  }

</style>
