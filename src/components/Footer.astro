
---
const links = [
  { href: "/", label: "Home" },
  { href: "/#approach", label: "Methodology" },
  { href: "/institute", label: "Institute" },
  { href: "/academy", label: "Academy" },
  { href: "/partnerships", label: "RMS" },
  { href: "/command-centre", label: "Command Centre" },
  { href: "/insights", label: "Insights" },
  { href: "/resources", label: "Resources" },
  { href: "/media", label: "Media Centre" },
  { href: "/partners", label: "Partners" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<footer>

  <div class="footer-inner">

    <div class="footer-top">

      <!-- Brand -->

      <div>

        <div class="footer-brand-logo">
          <img
            src="/assets/kiprod-logo-2026.png"
            alt="KIPROD"
            class="brand-logo-img"
          />
        </div>

        <div class="footer-brand-desc" style="color:#f3f4f6;">
  KIPROD is an institutional strengthening ecosystem helping financial institutions move from insight, through capability development, into execution and continuous performance improvement.
</div>

      </div>

      <!-- Navigation -->

      <div>

        <div class="footer-col-title" style="color:#ffffff;">
          Explore
        </div>

        <ul class="footer-links">
          {links.map((l) => (
            <li>
              <a
  href={l.href}
  style="color:#f3f4f6; text-decoration:none;"
>
  {l.label}
</a>
            </li>
          ))}
        </ul>

      </div>

      <!-- Journey -->

      <div>

        <div class="footer-col-title">
          Client Journey
        </div>

        <div class="footer-journey footer-journey-simple">
          <span>Discover</span>
          <span>Develop</span>
          <span>Sustain</span>
        </div>

      </div>

      <!-- Focus -->

      <div>

        <div class="footer-col-title">
          Institution Types
        </div>

        <div
  class="footer-badges"
  style="color:#ffffff;"
>

          <span>Banks</span>
<span>SACCOs</span>
<span>Microfinance</span>
<span>Credit Providers</span>
<span>Government</span>
<span>Regulators</span>
<span>DFIs</span>
<span>Co-operatives</span>

        </div>

      </div>

    </div>

    <div class="footer-divider"></div>

    <div class="footer-cta">

      <h3 style="color:#ffffff;">
        Ready to Begin Your Institutional Journey?
      </h3>

      <p style="color:#f3f4f6;">
        Every engagement begins with understanding your institution’s current priorities, capability gaps and operational realities before moving into targeted strengthening support.
      </p>

      <a href="/contact" class="btn-primary">
        Start Institutional Assessment →
      </a>

    </div>

    <div class="footer-divider"></div>

    <div class="footer-bottom">

<div class="footer-copy" style="color:#d1d5db;">
© 2026 KIPROD Institute. All Rights Reserved.
</div>

<div class="footer-markets" style="color:#facc15;">
Governance • Capability Development • Executive Learning • Implementation • Institutional Intelligence
</div>

</div>

  </div>


</footer>
<style>
  .footer-journey-simple,
  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: flex-start;
  }

  .footer-journey-simple span,
  .footer-badges span {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    margin: 0;
  }

  @media (max-width: 640px) {
    .footer-journey-simple,
    .footer-badges {
      gap: 8px;
    }
  }
</style>