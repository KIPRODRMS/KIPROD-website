---

---

<section class="hero" id="top">
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
  >
    <source src="/videos/abstract-network-optimized.mp4" type="video/mp4" />
  </video>

  <div class="hero-overlay"></div>
  <div class="hero-grid"></div>
  <div class="hero-glow hero-glow-left"></div>

<div class="hero-glow hero-glow-right"></div>

  <div class="hero-inner">

  <!-- LEFT CONTENT -->
  <div class="hero-text">

    <h1 class="hero-heading">
      Strengthening <em>Credit Risk</em>. Building
      <em>Resilient Institutions</em>.
    </h1>

    <div class="hero-divider"></div>

    <p class="hero-sub">
      Every institution is different. Before recommending learning,
      advisory, or implementation support, KIPROD helps institutions
      understand their current capability, identify strategic priorities,
      and develop a structured roadmap for institutional strengthening.
    </p>

    <p class="hero-insight">
      Sustainable institutional improvement begins with understanding—not
      assumptions. Our methodology combines governance insight,
      capability discovery, evidence-based assessment, and execution
      support to help institutions move from diagnosis to measurable
      performance improvement.
    </p>

    <div class="hero-actions">

      <a
        href="/contact?assessment=ilca"
        class="btn-primary"
      >
        Start Your Institutional Assessment →
      </a>

      <a
        href="/#ecosystem"
        class="btn-secondary"
      >
        Explore the KIPROD Ecosystem
        <span class="btn-arrow">→</span>
      </a>

    </div>

  </div>

  <!-- RIGHT VISUAL -->
  <div
    class="hero-visual"
    aria-label="KIPROD Institutional Engagement Methodology"
  >

    <div class="hero-visual-inner">

      <div class="hero-visual-label">
        Client Journey
      </div>

      <div class="hero-visual-title">
        Discover → Develop → Sustain
      </div>

      <div class="hero-visual-sub">
         A simplified view of how institutions move from initial understanding into capability development, execution support and continuous improvement.
      </div>

      <div class="methodology-flow client-journey-flow" role="list">

        <div class="flow-step" role="listitem">
          <div class="step-number">1</div>
<div class="step-content">
            
          <div class="step-title">Discover</div>
            <div class="step-code">Understand priorities, context and gaps</div>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step" role="listitem">
          <div class="step-number">2</div>
<div class="step-content">
            <div class="step-title">Develop</div>
            <div class="step-code">Build capability and improvement pathways</div>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step" role="listitem">
          <div class="step-number">3</div>
<div class="step-content">
            <div class="step-title">Sustain</div>
            <div class="step-code">Support execution and continuous improvement</div>
          </div>
        </div>
      </div>

    </div>

  </div>

</div> <!-- END hero-inner -->

<!-- TRUST BAR -->
<div class="hero-trust reveal">

  <div class="hero-trust-item">
    ✓ Financial Institutions
  </div>

  <div class="hero-trust-item">
    ✓ Government Agencies
  </div>

  <div class="hero-trust-item">
    ✓ Professional Bodies
  </div>

  <div class="hero-trust-item">
    ✓ Executive Leadership
  </div>

</div>

</section>

<!-- LOGO STRIP -->

<section class="logo-strip">

  <div class="section-inner">

    <p class="logo-heading">
      Institutions represented across our engagements
    </p>

    <div class="logo-grid">

      <div>KRA</div>
      <div>Family Bank</div>
      <div>Stima SACCO</div>
      <div>NITA</div>

      <div>Microfinance</div>
      <div>SACCOs</div>
      <div>Banks</div>
      <div>Government</div>

    </div>

  </div>

</section>
<style>
  .hero { min-height: 760px; padding: 132px 0 96px; }
  .hero-overlay { background: linear-gradient(105deg, rgba(4, 19, 42, .96), rgba(6, 29, 63, .89) 49%, rgba(5, 25, 53, .78)); }
  .hero-grid { opacity: .7; }
  .hero-glow-left { left: -280px; bottom: -380px; top: auto; right: auto; }
  .hero-glow-right { top: -320px; right: -250px; }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(360px, .78fr); gap: clamp(48px, 7vw, 104px); max-width: 1280px; padding: 0 clamp(24px, 5vw, 64px); }
  .hero-text { max-width: 660px; }
  .hero-heading { max-width: 650px; color: var(--white); font-size: clamp(3.2rem, 5.25vw, 5.25rem); line-height: 1.01; }
  .hero-divider { width: 56px; margin: 30px 0 24px; background: var(--gold); }
  .hero-sub { max-width: 570px; color: rgba(255,255,255,.78); font-size: clamp(1rem, 1.25vw, 1.15rem); line-height: 1.75; }
  .hero-actions { margin-top: 34px; gap: 14px; }
  .btn-primary, .btn-secondary { border-radius: 2px; padding: 15px 21px; }
  .hero-visual { background: linear-gradient(145deg, rgba(21, 53, 91, .9), rgba(7, 27, 57, .88)); border: 1px solid rgba(232,180,85,.35); border-radius: 12px; box-shadow: 0 28px 70px rgba(0,0,0,.34); overflow: hidden; }
  .hero-visual-inner { padding: clamp(26px, 3vw, 38px); }
  .hero-visual-label { display: inline-block; color: var(--gold-light); font: 600 .69rem/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; margin-bottom: 18px; }
  .hero-visual-title { color: var(--white); font: 600 clamp(1.75rem, 2.2vw, 2.35rem)/1.13 var(--font-display); margin-bottom: 14px; }
  .hero-visual-sub { color: rgba(255,255,255,.68); font-size: .94rem; line-height: 1.65; margin-bottom: 26px; }
  .methodology-flow { display: grid; gap: 10px; }
  .flow-step { display: flex; gap: 14px; align-items: flex-start; padding: 15px; background: rgba(255,255,255,.055); border: 1px solid rgba(255,255,255,.1); border-left: 3px solid var(--gold); border-radius: 6px; }
  .step-number { flex: 0 0 27px; width: 27px; height: 27px; display: grid; place-items: center; border-radius: 50%; background: var(--gold); color: var(--navy); font: 700 .75rem var(--font-mono); }
  .step-title { color: var(--white); font: 600 1.12rem/1.15 var(--font-display); margin-bottom: 5px; }
  .step-code { color: rgba(232,180,85,.92); font: .64rem/1.35 var(--font-mono); letter-spacing: .07em; text-transform: uppercase; }
  .flow-arrow { height: 12px; color: var(--gold-light); font-size: .9rem; line-height: 12px; text-align: center; }
  .hero-trust { position: absolute; z-index: 3; bottom: 34px; left: 50%; width: min(1152px, calc(100% - 48px)); transform: translateX(-50%); display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid rgba(255,255,255,.2); }
  .hero-trust-item { padding: 14px 16px 0; color: rgba(255,255,255,.85); font-size: .82rem; font-weight: 600; text-align: center; white-space: nowrap; }
  .logo-strip { padding: 64px 0; background: var(--white); }
  .logo-heading { margin-bottom: 26px; color: var(--muted); font: .68rem var(--font-mono); letter-spacing: .12em; text-align: center; text-transform: uppercase; }
  .logo-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .logo-grid div { padding: 20px; border: 1px solid #e9edf2; color: var(--navy); font-size: .88rem; font-weight: 700; text-align: center; }
  @media (max-width: 900px) { .hero { min-height: auto; padding: 132px 0 72px; } .hero-inner { grid-template-columns: 1fr; } .hero-visual { display: none; } .hero-trust { position: relative; bottom: auto; left: auto; width: 100%; transform: none; margin: 54px 0 0; grid-template-columns: repeat(2, 1fr); } .hero-trust-item { padding: 12px; } }
  @media (max-width: 560px) { .hero { padding-top: 116px; } .hero-heading { font-size: clamp(2.75rem, 13vw, 4rem); } .hero-actions { display: grid; } .btn-primary, .btn-secondary { justify-content: center; } .hero-trust { grid-template-columns: 1fr; gap: 2px; } .hero-trust-item { white-space: normal; } .logo-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
