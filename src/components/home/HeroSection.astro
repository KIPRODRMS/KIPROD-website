---

---

<section class="kiprod-hero" id="top">

  <!-- BACKGROUND VIDEO -->
  <video
    class="kiprod-hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
  >
    <source
      src="/videos/abstract-network-optimized.mp4"
      type="video/mp4"
    />
  </video>

  <div class="kiprod-hero-overlay"></div>
  <div class="kiprod-hero-grid"></div>

  <div class="kiprod-hero-glow kiprod-hero-glow-left"></div>
  <div class="kiprod-hero-glow kiprod-hero-glow-right"></div>


  <!-- ================================================
       MAIN HERO CONTENT
  ================================================= -->

  <div class="kiprod-hero-inner">

    <!-- ==============================================
         LEFT — HERO MESSAGE
    =============================================== -->

    <div class="kiprod-hero-copy">

      <div class="kiprod-hero-copy-inner">

        <div class="kiprod-hero-eyebrow">
          Institutional Strengthening
        </div>

        <h1>
          Strengthening
          <em>Credit Risk.</em>
          Building
          <em>Resilient Institutions.</em>
        </h1>

        <div class="kiprod-hero-rule"></div>

        <p class="kiprod-hero-lead">
          Every institution is different. KIPROD helps institutions
          understand their current capability, identify strategic
          priorities, and develop a structured roadmap for
          institutional strengthening.
        </p>

        <p class="kiprod-hero-support">
          Our approach connects governance insight, capability
          development and execution support — helping institutions
          move from understanding to measurable improvement.
        </p>

        <div class="kiprod-hero-actions">

          <a
            href="/contact?assessment=ilca"
            class="kiprod-btn-primary"
          >
            Start Your Institutional Assessment
            <span>→</span>
          </a>

          <a
            href="#ecosystem"
            class="kiprod-btn-secondary"
          >
            Explore the KIPROD Ecosystem
            <span>→</span>
          </a>

        </div>

      </div>

    </div>


    <!-- ==============================================
         RIGHT — DISCOVER / DEVELOP / SUSTAIN
    =============================================== -->

    <div class="kiprod-hero-journey">

      <div class="kiprod-journey-inner">

        <div class="kiprod-journey-eyebrow">
          Client Journey
        </div>

        <h2>
          Discover
          <span>→</span>
          Develop
          <span>→</span>
          Sustain
        </h2>

        <p class="kiprod-journey-description">
          A simplified view of how institutions move from
          understanding priorities to capability development,
          execution support and continuous improvement.
        </p>


        <!-- DISCOVER -->

        <div class="kiprod-journey-step">

          <div class="kiprod-step-number">
            1
          </div>

          <div class="kiprod-step-content">

            <strong>
              Discover
            </strong>

            <span>
              Understand priorities, context and gaps
            </span>

          </div>

        </div>


        <div class="kiprod-step-arrow">
          ↓
        </div>


        <!-- DEVELOP -->

        <div class="kiprod-journey-step">

          <div class="kiprod-step-number">
            2
          </div>

          <div class="kiprod-step-content">

            <strong>
              Develop
            </strong>

            <span>
              Build capability and improvement pathways
            </span>

          </div>

        </div>


        <div class="kiprod-step-arrow">
          ↓
        </div>


        <!-- SUSTAIN -->

        <div class="kiprod-journey-step">

          <div class="kiprod-step-number">
            3
          </div>

          <div class="kiprod-step-content">

            <strong>
              Sustain
            </strong>

            <span>
              Support execution and continuous improvement
            </span>

          </div>

        </div>

      </div>

    </div>

  </div>


  <!-- ================================================
       TRUST STRIP
  ================================================= -->

  <div class="kiprod-hero-trust">

    <div>
      Financial Institutions
    </div>

    <div>
      Government & Regulators
    </div>

    <div>
      Professional Bodies
    </div>

    <div>
      Executive Leadership
    </div>

  </div>

</section>


<style>

/* =====================================================
   HERO CONTAINER
===================================================== */

.kiprod-hero {
  position: relative;
  isolation: isolate;
  min-height: 690px;
  padding: 92px 0 100px;
  overflow: hidden;
  background: #061b38;
  color: var(--white);
}


/* =====================================================
   VIDEO BACKGROUND
===================================================== */

.kiprod-hero-video {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  z-index: -4;

  opacity: .34;
}


/* =====================================================
   DARK OVERLAY
===================================================== */

.kiprod-hero-overlay {
  position: absolute;
  inset: 0;

  z-index: -3;

  background:
    linear-gradient(
      100deg,
      rgba(3, 17, 38, .98) 0%,
      rgba(5, 27, 56, .96) 43%,
      rgba(5, 27, 56, .88) 70%,
      rgba(4, 21, 46, .91) 100%
    );
}


/* =====================================================
   GRID BACKGROUND
===================================================== */

.kiprod-hero-grid {
  position: absolute;
  inset: 0;

  z-index: -2;

  opacity: .38;

  background-image:
    linear-gradient(
      rgba(255,255,255,.055) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.055) 1px,
      transparent 1px
    );

  background-size: 56px 56px;

  mask-image:
    linear-gradient(
      to bottom,
      black 0%,
      rgba(0,0,0,.8) 70%,
      transparent 100%
    );
}


/* =====================================================
   GLOWS
===================================================== */

.kiprod-hero-glow {
  position: absolute;

  width: 520px;
  height: 520px;

  border-radius: 50%;

  filter: blur(80px);

  opacity: .16;

  z-index: -1;

  pointer-events: none;
}

.kiprod-hero-glow-left {
  left: -280px;
  bottom: -340px;

  background: #d59b35;
}

.kiprod-hero-glow-right {
  right: -250px;
  top: -280px;

  background: #2b6099;
}


/* =====================================================
   MAIN HERO GRID
===================================================== */

.kiprod-hero-inner {

  position: relative;

  width: min(
    1160px,
    calc(100% - 48px)
  );

  margin: 0 auto;

  display: grid;

  grid-template-columns:
    minmax(0, 1.02fr)
    minmax(390px, .78fr);

  align-items: center;

  gap: clamp(
    38px,
    6vw,
    82px
  );

}


/* =====================================================
   LEFT PANEL
===================================================== */

.kiprod-hero-copy {

  position: relative;

  border: 1px solid
    rgba(225, 172, 77, .42);

  border-left: 3px solid
    var(--gold);

  border-radius: 14px;

  background:
    linear-gradient(
      145deg,
      rgba(3, 22, 47, .88),
      rgba(4, 28, 57, .72)
    );

  box-shadow:
    0 28px 70px rgba(0,0,0,.25);

  backdrop-filter: blur(5px);

}


.kiprod-hero-copy-inner {

  padding:
    clamp(32px, 4vw, 46px);

}


/* =====================================================
   EYEBROW
===================================================== */

.kiprod-hero-eyebrow {

  display: inline-flex;

  align-items: center;

  padding: 8px 13px;

  margin-bottom: 22px;

  border: 1px solid
    rgba(224, 173, 77, .24);

  border-radius: 999px;

  color: var(--gold-light);

  font:
    600 .64rem/1
    var(--font-mono);

  letter-spacing: .14em;

  text-transform: uppercase;

}


/* =====================================================
   MAIN HEADING
===================================================== */

.kiprod-hero-copy h1 {

  margin: 0;

  max-width: 650px;

  color: var(--white);

  font:
    600 clamp(
      3rem,
      4.7vw,
      4.55rem
    ) /
    1.02
    var(--font-display);

  letter-spacing: -.025em;

}


.kiprod-hero-copy h1 em {

  color: #e8b454;

  font-style: italic;

  font-weight: 500;

}


/* =====================================================
   GOLD DIVIDER
===================================================== */

.kiprod-hero-rule {

  width: 36px;

  height: 2px;

  margin:
    25px 0 21px;

  background: var(--gold);

}


/* =====================================================
   BODY COPY
===================================================== */

.kiprod-hero-lead {

  max-width: 590px;

  margin: 0;

  color:
    rgba(255,255,255,.82);

  font-size:
    clamp(
      .92rem,
      1.05vw,
      1.02rem
    );

  line-height: 1.7;

}


.kiprod-hero-support {

  max-width: 590px;

  margin:
    14px 0 0;

  color:
    rgba(255,255,255,.58);

  font-size: .87rem;

  line-height: 1.65;

}


/* =====================================================
   ACTIONS
===================================================== */

.kiprod-hero-actions {

  display: flex;

  flex-wrap: wrap;

  gap: 12px;

  margin-top: 28px;

}


.kiprod-btn-primary,
.kiprod-btn-secondary {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 10px;

  min-height: 46px;

  padding:
    12px 17px;

  border-radius: 4px;

  font-size: .78rem;

  font-weight: 700;

  text-decoration: none;

  transition:
    transform .25s ease,
    background .25s ease,
    border-color .25s ease;

}


.kiprod-btn-primary {

  background: var(--gold);

  color: var(--navy);

  border: 1px solid var(--gold);

}


.kiprod-btn-primary:hover {

  transform: translateY(-2px);

  background: var(--gold-light);

}


.kiprod-btn-secondary {

  color: var(--white);

  border: 1px solid
    rgba(255,255,255,.25);

  background:
    rgba(255,255,255,.055);

}


.kiprod-btn-secondary:hover {

  transform: translateY(-2px);

  border-color:
    rgba(232,180,84,.65);

  background:
    rgba(255,255,255,.09);

}


/* =====================================================
   RIGHT JOURNEY PANEL
===================================================== */

.kiprod-hero-journey {

  align-self: center;

  border:
    1px solid
    rgba(224, 173, 77, .42);

  border-radius: 12px;

  background:
    linear-gradient(
      145deg,
      rgba(16, 48, 82, .88),
      rgba(7, 29, 59, .92)
    );

  box-shadow:
    0 26px 65px rgba(0,0,0,.30);

  overflow: hidden;

}


.kiprod-journey-inner {

  padding:
    clamp(28px, 3vw, 38px);

}


/* =====================================================
   JOURNEY HEADER
===================================================== */

.kiprod-journey-eyebrow {

  margin-bottom: 17px;

  color:
    var(--gold-light);

  font:
    600 .62rem/1
    var(--font-mono);

  letter-spacing: .15em;

  text-transform: uppercase;

}


.kiprod-hero-journey h2 {

  margin: 0 0 13px;

  color: var(--white);

  font:
    500 clamp(
      1.55rem,
      2vw,
      2rem
    ) /
    1.15
    var(--font-display);

}


.kiprod-hero-journey h2 span {

  color: var(--gold);

  padding: 0 3px;

}


.kiprod-journey-description {

  margin: 0 0 24px;

  color:
    rgba(255,255,255,.62);

  font-size: .78rem;

  line-height: 1.65;

}


/* =====================================================
   JOURNEY STEP
===================================================== */

.kiprod-journey-step {

  display: flex;

  align-items: flex-start;

  gap: 13px;

  padding:
    13px 14px;

  border:
    1px solid
    rgba(255,255,255,.09);

  border-left:
    3px solid var(--gold);

  border-radius: 5px;

  background:
    rgba(255,255,255,.045);

}


.kiprod-step-number {

  flex:
    0 0 25px;

  width: 25px;

  height: 25px;

  display: grid;

  place-items: center;

  border-radius: 50%;

  background:
    var(--gold);

  color:
    var(--navy);

  font:
    700 .68rem
    var(--font-mono);

}


.kiprod-step-content {

  display: flex;

  flex-direction: column;

  gap: 4px;

}


.kiprod-step-content strong {

  color: var(--white);

  font:
    600 1rem/1.1
    var(--font-display);

}


.kiprod-step-content span {

  color:
    rgba(232,180,85,.86);

  font:
    .56rem/1.35
    var(--font-mono);

  letter-spacing: .055em;

  text-transform: uppercase;

}


/* =====================================================
   ARROWS
===================================================== */

.kiprod-step-arrow {

  height: 16px;

  display: flex;

  align-items: center;

  justify-content: center;

  color:
    var(--gold-light);

  font-size: .8rem;

}


/* =====================================================
   TRUST STRIP
===================================================== */

.kiprod-hero-trust {

  position: absolute;

  left: 50%;

  bottom: 22px;

  transform:
    translateX(-50%);

  width: min(
    1080px,
    calc(100% - 48px)
  );

  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  border-top:
    1px solid
    rgba(255,255,255,.15);

}


.kiprod-hero-trust div {

  padding:
    11px 12px 0;

  color:
    rgba(255,255,255,.62);

  font-size: .65rem;

  font-weight: 600;

  text-align: center;

}


/* =====================================================
   TABLET
===================================================== */

@media (max-width: 1000px) {

  .kiprod-hero {

    padding:
      76px 0 90px;

  }

  .kiprod-hero-inner {

    grid-template-columns:
      1fr;

    max-width: 720px;

  }

  .kiprod-hero-copy h1 {

    max-width: 620px;

  }

  .kiprod-hero-journey {

    max-width: 620px;

    width: 100%;

    justify-self: center;

  }

}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 600px) {

  .kiprod-hero {

    min-height: auto;

    padding:
      48px 0 32px;

  }


  .kiprod-hero-inner {

    width:
      calc(100% - 28px);

    gap: 22px;

  }


  .kiprod-hero-copy-inner {

    padding: 26px 22px;

  }


  .kiprod-hero-copy h1 {

    font-size:
      clamp(
        2.55rem,
        12vw,
        3.5rem
      );

    line-height: 1.02;

  }


  .kiprod-hero-actions {

    display: grid;

    grid-template-columns: 1fr;

  }


  .kiprod-btn-primary,
  .kiprod-btn-secondary {

    width: 100%;

  }


  .kiprod-journey-inner {

    padding: 25px 20px;

  }


  .kiprod-hero-trust {

    position: relative;

    left: auto;

    bottom: auto;

    transform: none;

    width:
      calc(100% - 28px);

    margin:
      28px auto 0;

    grid-template-columns:
      repeat(2, 1fr);

  }


  .kiprod-hero-trust div {

    padding: 11px 8px;

  }

}


/* =====================================================
   VERY SMALL SCREENS
===================================================== */

@media (max-width: 390px) {

  .kiprod-hero-copy h1 {

    font-size: 2.45rem;

  }

  .kiprod-hero-eyebrow {

    font-size: .57rem;

  }

}

/* ============================================================
   KIPROD PERMANENT ALIGNMENT LOCK - HOMEPAGE HERO
   Balanced, centred and deliberately asymmetrical.
   ============================================================ */

.kiprod-hero-inner {
  width: min(1200px, calc(100% - 64px));
  max-width: 1200px;
  margin-left: auto;
  margin-right: auto;

  grid-template-columns:
    minmax(0, 1.12fr)
    minmax(420px, .88fr);

  gap: 48px;
  align-items: center;
}

.kiprod-hero-copy,
.kiprod-hero-journey {
  min-width: 0;
}

.kiprod-hero-copy-inner {
  width: 100%;
  max-width: none;
  margin: 0;
  padding: clamp(36px, 3vw, 44px);
}

.kiprod-hero-copy h1 {
  max-width: 100%;
  font-size: clamp(3rem, 3.55vw, 3.9rem);
  line-height: 1.035;
  letter-spacing: -.025em;
  text-wrap: balance;
  overflow-wrap: normal;
  word-break: normal;
}

.kiprod-hero-lead,
.kiprod-hero-support {
  max-width: 100%;
}

.kiprod-hero-trust {
  width: min(1120px, calc(100% - 64px));
}

@media (max-width: 1100px) {
  .kiprod-hero {
    padding: 72px 0 80px;
  }

  .kiprod-hero-inner {
    width: min(760px, calc(100% - 56px));
    max-width: 760px;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .kiprod-hero-copy,
  .kiprod-hero-journey {
    width: 100%;
    max-width: 760px;
    justify-self: center;
  }

  .kiprod-hero-copy-inner {
    padding: 38px 42px;
  }

  .kiprod-hero-copy h1 {
    max-width: 620px;
    font-size: clamp(2.8rem, 6.2vw, 3.55rem);
    line-height: 1.04;
  }

  .kiprod-hero-lead,
  .kiprod-hero-support {
    max-width: 620px;
  }

  .kiprod-hero-trust {
    width: min(760px, calc(100% - 56px));
  }
}

@media (max-width: 600px) {
  .kiprod-hero {
    padding: 46px 0 30px;
  }

  .kiprod-hero-inner {
    width: calc(100% - 36px);
    max-width: none;
    gap: 20px;
  }

  .kiprod-hero-copy,
  .kiprod-hero-journey {
    max-width: none;
  }

  .kiprod-hero-copy-inner {
    padding: 26px 22px;
  }

  .kiprod-hero-copy h1 {
    max-width: 100%;
    font-size: clamp(2.2rem, 10.4vw, 2.9rem);
    line-height: 1.045;
  }

  .kiprod-hero-trust {
    width: calc(100% - 36px);
  }
}


</style>