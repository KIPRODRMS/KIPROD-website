---

---

<section class="hero" id="top">

  <!-- Background video -->
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
  >
    <source
      src="/videos/abstract-network-optimized.mp4"
      type="video/mp4"
    />
  </video>

  <div class="hero-overlay"></div>
  <div class="hero-grid"></div>

  <div class="hero-glow hero-glow-left"></div>
  <div class="hero-glow hero-glow-right"></div>


  <div class="hero-inner">

    <!-- =====================================================
         HERO MESSAGE
    ====================================================== -->

    <div class="hero-text">

  <div class="section-tag hero-tag">
    Institutional Strengthening
  </div>

  <h1 class="hero-heading">
    Strengthening <em>Credit Risk</em>.
    Building <em>Resilient Institutions</em>.
  </h1>

  <div class="hero-divider"></div>

  <p class="hero-sub">
    KIPROD helps financial institutions understand their
    capability, identify strategic priorities and move from
    institutional assessment to measurable improvement.
  </p>

  <div class="hero-actions">

    <a
      href="/contact?assessment=ilca"
      class="btn-primary"
    >
      Start Your Institutional Assessment →
    </a>

    <a
      href="/#ecosystem"
      class="btn-secondary"
    >
      Explore the KIPROD Ecosystem
      <span class="btn-arrow">→</span>
    </a>

  </div>

</div>


    <!-- =====================================================
         CLIENT JOURNEY
         Keep this visual — it is one of the strongest ideas.
    ====================================================== -->

    <div
      class="hero-visual"
      aria-label="KIPROD institutional strengthening journey"
    >

      <div class="hero-visual-inner">

        <div class="hero-visual-label">
          The KIPROD Journey
        </div>

        <div class="hero-visual-title">
          Discover → Develop → Sustain
        </div>

        <p class="hero-visual-sub">
          A structured journey from understanding institutional
          priorities to capability development, execution and
          continuous improvement.
        </p>


        <div
          class="methodology-flow client-journey-flow"
          role="list"
        >

          <div class="flow-step" role="listitem">

            <div class="step-number">
              1
            </div>

            <div class="step-content">

              <div class="step-title">
                Discover
              </div>

              <div class="step-code">
                Understand priorities, context and gaps
              </div>

            </div>

          </div>


          <div class="flow-arrow">
            ↓
          </div>


          <div class="flow-step" role="listitem">

            <div class="step-number">
              2
            </div>

            <div class="step-content">

              <div class="step-title">
                Develop
              </div>

              <div class="step-code">
                Build capability and improvement pathways
              </div>

            </div>

          </div>


          <div class="flow-arrow">
            ↓
          </div>


          <div class="flow-step" role="listitem">

            <div class="step-number">
              3
            </div>

            <div class="step-content">

              <div class="step-title">
                Sustain
              </div>

              <div class="step-code">
                Support execution and continuous improvement
              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>


  <!-- =====================================================
       WHO WE SERVE
       This replaces the old generic "trust" bar.
  ====================================================== -->

  <div class="hero-trust reveal">

    <div class="hero-trust-label">
      Who We Serve
    </div>

    <div class="hero-trust-item">
      Banks
    </div>

    <div class="hero-trust-item">
      SACCOs
    </div>

    <div class="hero-trust-item">
      Microfinance & Credit Providers
    </div>

    <div class="hero-trust-item">
      Government & Regulators
    </div>

    <div class="hero-trust-item">
      DFIs & Cooperatives
    </div>

  </div>

</section>


<style>

  /* =========================================================
     HERO
  ========================================================== */

  .hero {
    position: relative;
    min-height: 760px;
    padding: 132px 0 118px;
    overflow: hidden;
  }


  .hero-overlay {
    background:
      linear-gradient(
        105deg,
        rgba(4, 19, 42, .97),
        rgba(6, 29, 63, .91) 49%,
        rgba(5, 25, 53, .82)
      );
  }


  .hero-grid {
    opacity: .7;
  }


  .hero-glow-left {
    left: -280px;
    bottom: -380px;
    top: auto;
    right: auto;
  }


  .hero-glow-right {
    top: -320px;
    right: -250px;
  }


  /* =========================================================
     INNER
  ========================================================== */

  .hero-inner {
    position: relative;
    z-index: 2;

    display: grid;

    grid-template-columns:
      minmax(0, 1.08fr)
      minmax(360px, .78fr);

    gap: clamp(48px, 7vw, 104px);

    max-width: 1280px;

    margin: 0 auto;

    padding:
      0
      clamp(24px, 5vw, 64px);
  }


  /* =========================================================
     TEXT
  ========================================================== */

  .hero-text {
    max-width: 660px;

    align-self: center;
  }


  .hero-kicker {
    display: inline-flex;

    margin-bottom: 22px;

    color: var(--gold-light);

    font:
      600 .69rem/1
      var(--font-mono);

    letter-spacing: .15em;

    text-transform: uppercase;
  }


  .hero-heading {
    max-width: 650px;

    color: var(--white);

    font-size:
      clamp(3.2rem, 5.25vw, 5.25rem);

    line-height: 1.01;

    letter-spacing: -.025em;

    margin: 0;
  }


  .hero-divider {
    width: 56px;

    height: 2px;

    margin: 30px 0 24px;

    background: var(--gold);
  }


  .hero-sub {
    max-width: 590px;

    margin: 0;

    color:
      rgba(255,255,255,.78);

    font-size:
      clamp(1rem, 1.25vw, 1.15rem);

    line-height: 1.75;
  }


  /* =========================================================
     ACTIONS
  ========================================================== */

  .hero-actions {

    display: flex;

    flex-wrap: wrap;

    align-items: center;

    gap: 14px;

    margin-top: 34px;
  }


  .btn-primary,
  .btn-secondary {

    border-radius: 2px;

    padding:
      15px 21px;

    text-decoration: none;

    transition:
      transform .25s ease,
      background .25s ease,
      border-color .25s ease;
  }


  .btn-primary:hover,
  .btn-secondary:hover {
    transform: translateY(-2px);
  }


  .btn-arrow {
    margin-left: 6px;
  }


  /* =========================================================
     JOURNEY VISUAL
  ========================================================== */

  .hero-visual {

    align-self: center;

    background:
      linear-gradient(
        145deg,
        rgba(21, 53, 91, .92),
        rgba(7, 27, 57, .90)
      );

    border:
      1px solid
      rgba(232,180,85,.35);

    border-radius: 12px;

    box-shadow:
      0 28px 70px
      rgba(0,0,0,.34);

    overflow: hidden;
  }


  .hero-visual-inner {

    padding:
      clamp(26px, 3vw, 38px);
  }


  .hero-visual-label {

    display: inline-block;

    margin-bottom: 18px;

    color:
      var(--gold-light);

    font:
      600 .69rem/1
      var(--font-mono);

    letter-spacing: .14em;

    text-transform: uppercase;
  }


  .hero-visual-title {

    margin-bottom: 14px;

    color: var(--white);

    font:
      600
      clamp(1.75rem, 2.2vw, 2.35rem)/1.13
      var(--font-display);
  }


  .hero-visual-sub {

    margin:
      0 0 26px;

    color:
      rgba(255,255,255,.68);

    font-size: .94rem;

    line-height: 1.65;
  }


  /* =========================================================
     JOURNEY FLOW
  ========================================================== */

  .methodology-flow {

    display: grid;

    gap: 10px;
  }


  .flow-step {

    display: flex;

    gap: 14px;

    align-items: flex-start;

    padding: 15px;

    background:
      rgba(255,255,255,.055);

    border:
      1px solid
      rgba(255,255,255,.1);

    border-left:
      3px solid
      var(--gold);

    border-radius: 6px;
  }


  .step-number {

    flex:
      0 0 27px;

    width: 27px;

    height: 27px;

    display: grid;

    place-items: center;

    border-radius: 50%;

    background:
      var(--gold);

    color:
      var(--navy);

    font:
      700 .75rem
      var(--font-mono);
  }


  .step-title {

    margin-bottom: 5px;

    color: var(--white);

    font:
      600 1.12rem/1.15
      var(--font-display);
  }


  .step-code {

    color:
      rgba(232,180,85,.92);

    font:
      .64rem/1.35
      var(--font-mono);

    letter-spacing: .07em;

    text-transform: uppercase;
  }


  .flow-arrow {

    height: 12px;

    color:
      var(--gold-light);

    font-size: .9rem;

    line-height: 12px;

    text-align: center;
  }


  /* =========================================================
     WHO WE SERVE
  ========================================================== */

  .hero-trust {

    position: relative;

    z-index: 3;

    width:
      min(
        1180px,
        calc(100% - 48px)
      );

    margin:
      68px auto 0;

    display: grid;

    grid-template-columns:
      1.15fr
      repeat(5, 1fr);

    align-items: center;

    border-top:
      1px solid
      rgba(255,255,255,.18);

    border-bottom:
      1px solid
      rgba(255,255,255,.08);
  }


  .hero-trust-label {

    padding:
      17px 16px;

    color:
      var(--gold-light);

    font:
      600 .65rem
      var(--font-mono);

    letter-spacing: .12em;

    text-transform: uppercase;
  }


  .hero-trust-item {

    padding:
      17px 12px;

    color:
      rgba(255,255,255,.76);

    font-size: .76rem;

    font-weight: 600;

    text-align: center;

    border-left:
      1px solid
      rgba(255,255,255,.08);
  }


  /* =========================================================
     TABLET
  ========================================================== */

  @media (max-width: 1050px) {

    .hero-inner {

      grid-template-columns:
        1fr 1fr;

      gap: 42px;
    }

    .hero-trust {

      grid-template-columns:
        repeat(3, 1fr);
    }

    .hero-trust-label {

      grid-column:
        1 / -1;

      border-bottom:
        1px solid
        rgba(255,255,255,.08);

      text-align: center;
    }

  }


  /* =========================================================
     MOBILE
  ========================================================== */

  @media (max-width: 900px) {

    .hero {

      min-height: auto;

      padding:
        120px 0 72px;
    }


    .hero-inner {

      grid-template-columns: 1fr;

      gap: 48px;
    }


    .hero-text {

      max-width: 700px;
    }


    .hero-visual {

      max-width: 680px;

      width: 100%;
    }


    .hero-trust {

      margin-top: 52px;

      grid-template-columns:
        repeat(2, 1fr);
    }


    .hero-trust-label {

      grid-column:
        1 / -1;
    }

  }


  /* =========================================================
     SMALL MOBILE
  ========================================================== */

  @media (max-width: 560px) {

    .hero {

      padding-top: 108px;
    }


    .hero-heading {

      font-size:
        clamp(
          2.75rem,
          13vw,
          4rem
        );
    }


    .hero-actions {

      display: grid;

      grid-template-columns: 1fr;
    }


    .btn-primary,
    .btn-secondary {

      display: flex;

      justify-content: center;

      width: 100%;

      box-sizing: border-box;
    }


    .hero-trust {

      width:
        calc(100% - 32px);

      grid-template-columns: 1fr;
    }


    .hero-trust-item {

      border-left: 0;

      border-top:
        1px solid
        rgba(255,255,255,.07);
    }

  }

</style>