---
import InsightGrid from "../InsightGrid.astro";

const { posts = [] } = Astro.props;
---

<section class="about" id="insights" style="background: var(--cream)">
  <div class="section-inner">

    <div class="section-tag reveal">
      Insights
    </div>

    <h2 class="section-heading reveal">
      Executive governance <em>intelligence</em>
    </h2>

    <p class="section-sub reveal">
      Decision-useful perspectives on governance, portfolio risk, institutional
  capability and emerging credit-risk issues for boards and executive leaders.
    </p>

    <InsightGrid posts={posts} columns={3} />

  </div>
</section>