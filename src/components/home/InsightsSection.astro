---
import InsightGrid from "../InsightGrid.astro";

const { posts = [] } = Astro.props;
---

<section class="about insights-section" id="insights">

  <div class="section-inner">

    <div class="section-tag reveal">
      KIPROD Credit Risk Institute
    </div>

    <h2 class="section-heading reveal">
      Executive governance <em>intelligence</em>
    </h2>

    <p class="section-sub reveal">
      Decision-useful perspectives on governance, portfolio risk, institutional
      capability and emerging credit-risk issues for boards and executive leaders.
    </p>


    <div class="insight-pathways reveal">
      <span>Executive Conversations</span>
      <span>Briefing Notes</span>
      <span>Research &amp; Publications</span>
      <span>Sector Intelligence</span>
    </div>


    <article class="executive-conversation reveal">

      <div class="conversation-copy">

        <div class="conversation-eyebrow">
          Upcoming Executive Conversation
        </div>

        <h3>
          From Training to Institutional Capability
        </h3>

        <p class="conversation-title">
          A CEO Conversation on Strengthening Credit Risk Performance
        </p>

        <p class="conversation-desc">
          A focused executive conversation for SACCO CEOs and senior credit
          leaders on how institutions connect governance, risk appetite,
          people capability, processes, MIS and execution to achieve sustained
          credit-risk improvement.
        </p>

      </div>


      <div class="conversation-action">

        <div class="conversation-meta">
          <strong>Thursday, 8 October 2026</strong>
          <span>10:00–11:00 EAT</span>
          <span>Virtual · 60 Minutes</span>
          <span>Complimentary · Invitation Only</span>
        </div>

        <a
          href="https://forms.gle/5CnmjvS2TMWevtYh8"
          class="btn-primary"
          target="_blank"
          rel="noreferrer"
        >
          Register / Request Invitation →
        </a>

        <a
          href="/institute"
          class="conversation-secondary"
        >
          Explore the Institute →
        </a>

      </div>

    </article>


    <div class="latest-insights-heading reveal">
      <span>Latest Institute insights</span>
      <a href="/insights">View all insights →</a>
    </div>

    <InsightGrid posts={posts} columns={3} />

  </div>

</section>


<style>

  .about.insights-section {
    padding: 68px 0;
    background: var(--cream);
  }

  .insight-pathways {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .insight-pathways span {
    padding: 7px 10px;
    border: 1px solid rgba(9,34,74,.12);
    background: rgba(255,255,255,.55);
    color: var(--navy);
    font-size: .69rem;
    font-weight: 600;
  }

  .executive-conversation {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(260px, .55fr);
    gap: 34px;
    margin-top: 30px;
    padding: 28px;
    background: var(--navy);
    border-left: 4px solid var(--gold);
  }

  .conversation-eyebrow {
    margin-bottom: 12px;
    color: var(--gold-light);
    font: 600 .68rem/1 var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .conversation-copy h3 {
    margin: 0;
    color: var(--white);
    font: 600 clamp(1.8rem, 3vw, 2.65rem)/1.05 var(--font-display);
  }

  .conversation-title {
    margin: 10px 0 0;
    color: var(--gold-light);
    font-size: .94rem;
    font-weight: 600;
  }

  .conversation-desc {
    max-width: 760px;
    margin: 16px 0 0;
    color: rgba(255,255,255,.72);
    font-size: .9rem;
    line-height: 1.65;
  }

  .conversation-action {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
  }

  .conversation-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 18px;
    color: rgba(255,255,255,.68);
    font-size: .77rem;
    line-height: 1.45;
  }

  .conversation-meta strong {
    color: var(--white);
  }

  .conversation-action .btn-primary {
    text-align: center;
  }

  .conversation-secondary {
    margin-top: 13px;
    color: rgba(255,255,255,.78);
    font-size: .78rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }

  .conversation-secondary:hover {
    color: var(--gold-light);
  }

  .latest-insights-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin: 38px 0 20px;
    padding-top: 24px;
    border-top: 1px solid rgba(9,34,74,.12);
  }

  .latest-insights-heading span {
    color: var(--navy);
    font: 600 1.2rem/1.2 var(--font-display);
  }

  .latest-insights-heading a {
    color: var(--navy);
    font-size: .78rem;
    font-weight: 700;
    text-decoration: none;
  }

  .latest-insights-heading a:hover {
    color: var(--gold);
  }

  @media (max-width: 820px) {

    .executive-conversation {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .conversation-action {
      align-items: flex-start;
    }

    .conversation-action .btn-primary {
      width: 100%;
    }

  }

  @media (max-width: 600px) {

    .about.insights-section {
      padding: 56px 0;
    }

    .executive-conversation {
      padding: 23px 20px;
    }

    .latest-insights-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

  }

</style>
