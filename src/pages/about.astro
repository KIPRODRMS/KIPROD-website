---
import BaseLayout from "../layouts/BaseLayout.astro";
import FacultySection from "../components/FacultySection.astro";
---

<BaseLayout
  title="About KIPROD | Institutional Strengthening & Credit Risk Expertise"
  description="Learn about KIPROD Risk Management Services, the institutional strengthening approach, specialist expertise and four complementary delivery capabilities."
  activePath="/about"
>
  <section class="page-header about-identity-hero">
    <div class="page-header-inner">
      <h1 class="page-heading">About <em>KIPROD</em></h1>
      <p class="page-sub">KIPROD Risk Management Services Ltd works with financial institutions to strengthen governance, credit risk management, institutional capability and operational performance.</p>
      <p class="page-sub" style="margin-top:16px">We respond to the priorities institutions bring to us, combining specialist insight with practical support for capability development, advisory and execution.</p>
      <div class="page-actions">
        <a href="/contact" class="btn-primary">Discuss an Institutional Priority &rarr;</a>
        <a href="#who-we-are" class="btn-secondary">Get to Know KIPROD &rarr;</a>
      </div>
    </div>
  </section>

  <section class="about about-refine" id="who-we-are">
    <div class="section-inner about-story-grid">
      <div>
        <div class="section-tag reveal">Institutional Identity</div>
        <h2 class="section-heading reveal">A firm focused on <em>practical institutional strengthening</em></h2>
      </div>
      <div class="about-story-copy reveal">
        <p>KIPROD Risk Management Services Ltd brings together institutional strengthening services for banks, SACCOs, microfinance institutions, lenders and other organisations operating in the financial sector.</p>
        <p>Its work connects governance, credit risk management, professional capability and operational execution. Institutions may engage KIPROD for a clearly identified training or advisory requirement, or request structured diagnostic support where priorities need further clarification.</p>
        <p>The Institute, Academy, RMS and Command Centre are complementary delivery capabilities offered by KIPROD—not separate compulsory steps that every client must complete.</p>
      </div>
    </div>
  </section>

  <section class="institutional about-refine">
    <div class="section-inner">
      <div class="about-grid about-two-col">
        <div class="mini-panel reveal" style="background:var(--white)">
          <h2 class="mini-title">Our Vision</h2>
          <p class="mini-note">To be a leading institutional strengthening partner, enabling resilient governance, capable institutions and sustainable performance across Africa's financial sector.</p>
        </div>
        <div class="mini-panel reveal" style="background:var(--white)">
          <h2 class="mini-title">Our Mission</h2>
          <p class="mini-note">To strengthen financial institutions through institutional insight, capability development and practical execution support that improves governance, risk management and organisational performance.</p>
        </div>
      </div>
    </div>
  </section>

  <FacultySection />

  <section class="about about-refine" id="principles">
    <div class="section-inner">
      <div class="section-tag reveal">Operating Principles</div>
      <h2 class="section-heading reveal">How we approach <em>institutional work</em></h2>
      <div class="values-grid">
        <article class="value-card reveal"><span>01</span><h3>Integrity in decision-making</h3><p>Transparent, accountable and responsible institutional decisions.</p></article>
        <article class="value-card reveal"><span>02</span><h3>Execution excellence</h3><p>Disciplined implementation, measurable follow-through and operational consistency.</p></article>
        <article class="value-card reveal"><span>03</span><h3>Professional respect</h3><p>Respect for institutional context, professional experience and local realities.</p></article>
        <article class="value-card reveal"><span>04</span><h3>Practical impact</h3><p>Visible improvement in capability, governance, risk management and performance.</p></article>
        <article class="value-card reveal"><span>05</span><h3>Partnership mindset</h3><p>Long-term institutional strengthening rather than isolated interventions.</p></article>
        <article class="value-card reveal"><span>06</span><h3>One ecosystem</h3><p>Insight, capability, execution and continuous improvement working together.</p></article>
      </div>
    </div>
  </section>

  <section class="institutional about-refine" id="approach">
    <div class="section-inner">
      <div class="section-tag reveal">Institutional Strengthening Approach</div>
      <h2 class="section-heading reveal">From insight to <em>sustained improvement</em></h2>
      <p class="section-sub reveal">Our work draws on four connected considerations: insight into the institution's needs, the capability to act, disciplined execution, and continued visibility of performance. They guide the approach; they are not compulsory service stages.</p>
      <div class="model-grid">
        <article class="model-card reveal"><span>Insight</span><h3>Understand context</h3><p>Clarify institutional priorities, governance, risk and available evidence.</p></article>
        <article class="model-card reveal"><span>Capability</span><h3>Equip people and systems</h3><p>Strengthen practical knowledge, processes and decision-making.</p></article>
        <article class="model-card reveal"><span>Execution</span><h3>Support implementation</h3><p>Translate institutional decisions into accountable practice.</p></article>
        <article class="model-card reveal"><span>Continuous Improvement</span><h3>Sustain progress</h3><p>Improve visibility, oversight and follow-through as circumstances evolve.</p></article>
      </div>
    </div>
  </section>

  <section class="about about-refine" id="ecosystem">
    <div class="section-inner">
      <div class="section-tag reveal">Delivery Capabilities</div>
      <h2 class="section-heading reveal">One firm. <em>Four ways to support institutions.</em></h2>
      <p class="section-sub reveal">KIPROD brings together four complementary capabilities, selected according to an institution's needs.</p>
      <div class="ecosystem-about-grid">
        <article class="ecosystem-about-card reveal"><span>Insight</span><h3>KIPROD Credit Risk Institute</h3><p>Research, executive intelligence and institutional perspectives.</p><a href="/institute">Explore Institute &rarr;</a></article>
        <article class="ecosystem-about-card reveal"><span>Capability</span><h3>KIPROD Risk Management Academy</h3><p>Executive learning, institutional programmes and board development.</p><a href="/academy">Explore Academy &rarr;</a></article>
        <article class="ecosystem-about-card reveal"><span>Execution</span><h3>KIPROD RMS</h3><p>Advisory, governance, policy and implementation support.</p><a href="/partnerships">Explore RMS &rarr;</a></article>
        <article class="ecosystem-about-card reveal"><span>Continuous Improvement</span><h3>KIPROD Command Centre</h3><p>Executive visibility, early warning, board oversight and execution tracking.</p><a href="/command-centre">Explore Command Centre &rarr;</a></article>
      </div>
    </div>
  </section>

  <section class="institutional about-refine" id="engagement-journey">
    <div class="section-inner methodology-overview">
      <div>
        <div class="section-tag reveal">Optional Assessment Methodology</div>
        <h2 class="section-heading reveal">Structured assessment <em>when it adds value</em></h2>
      </div>
      <div class="reveal">
        <p>Institutions with defined priorities can proceed directly to targeted programmes, advisory or implementation. When a wider diagnostic view is helpful, KIPROD can apply a structured assessment pathway.</p>
        <p><strong>Assess (ILCA) → Review → Discover (ICDF) → Roadmap (ICAR)</strong></p>
        <p>That assessment process informs a tailored institutional strengthening roadmap; it is not required before every engagement.</p>
        <a class="btn-secondary" href="/contact?assessment=ilca">Enquire About Institutional Assessment &rarr;</a>
      </div>
    </div>
  </section>

  <section class="about about-refine" id="experience">
    <div class="section-inner about-story-grid">
      <div>
        <div class="section-tag reveal">Experience &amp; Credibility</div>
        <h2 class="section-heading reveal">Expertise built through <em>professional practice</em></h2>
      </div>
      <div class="about-story-copy reveal">
        <p>KIPROD's specialist profiles describe experience accumulated by individual professionals across financial institutions and institutional capability engagements. That professional background should be distinguished from assignments directly contracted to KIPROD.</p>
        <p>Detailed institutional references and company-specific case studies will be published once the relevant engagement history and permissions have been verified.</p>
        <a class="about-text-link" href="/academy#faculty">Meet Our Specialists &rarr;</a>
      </div>
    </div>
  </section>

  <section class="about about-refine about-engage" id="engage">
    <div class="section-inner">
      <div class="section-tag reveal">Engage KIPROD</div>
      <h2 class="section-heading reveal">Start with <em>your institution's priorities</em></h2>
      <p class="section-sub reveal">Discuss an executive priority, request a targeted capability programme, or explore a structured assessment. We will help identify a suitable next step.</p>
      <div class="about-engage-actions reveal">
        <a href="/contact" class="btn-primary">Discuss an Institutional Priority &rarr;</a>
        <a href="/academy" class="btn-secondary">Explore Academy Programmes &rarr;</a>
        <a href="/contact?assessment=ilca" class="about-text-link">Enquire About ILCA &rarr;</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-refine { padding:clamp(52px,6vw,74px) 0; }
  .about-identity-hero .page-sub { max-width:820px; }
  .about-story-grid,.methodology-overview { display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(24px,5vw,64px);align-items:start; }
  .about-story-copy p,.methodology-overview p { color:var(--muted);font-size:1rem;line-height:1.75;margin:0 0 16px; }
  .methodology-overview strong { color:var(--navy);font-weight:700; }
  .about-two-col { grid-template-columns:repeat(2,minmax(0,1fr));gap:18px; }
  .about-two-col .mini-panel { margin:0;padding:26px; }
  .values-grid { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:26px; }
  .model-grid,.ecosystem-about-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:28px; }
  .value-card,.model-card,.ecosystem-about-card { min-width:0;background:var(--white);border:1px solid rgba(9,34,74,.1);padding:24px; }
  .value-card span,.model-card span,.ecosystem-about-card span { color:#9c641c;font:700 .7rem/1.4 var(--font-mono);letter-spacing:.06em;text-transform:uppercase; }
  .value-card h3,.model-card h3,.ecosystem-about-card h3 { margin:11px 0 8px;color:var(--navy);font:600 1.3rem/1.15 var(--font-display); }
  .value-card p,.model-card p,.ecosystem-about-card p { margin:0;color:var(--muted);font-size:.91rem;line-height:1.65; }
  .ecosystem-about-card { display:flex;flex-direction:column; }
  .ecosystem-about-card a { margin-top:auto;padding-top:16px;color:#996219;font-weight:700;text-decoration:none; }
  .ecosystem-about-card a:hover,.about-text-link:hover { text-decoration:underline; }
  .methodology-overview .btn-secondary { display:inline-flex;margin-top:14px; }
  .about-text-link { display:inline-block;color:#996219;font-size:.91rem;font-weight:700;text-decoration:none; }
  .about-engage { background:var(--cream); }
  .about-engage-actions { display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-top:26px; }
  @media(max-width:900px) { .about-story-grid,.methodology-overview {grid-template-columns:1fr;gap:12px;} .values-grid{grid-template-columns:repeat(2,minmax(0,1fr));} }
  @media(max-width:600px) { .about-refine{padding:50px 0;} .about-two-col,.values-grid,.model-grid,.ecosystem-about-grid{grid-template-columns:1fr;} .about-engage-actions{align-items:stretch;flex-direction:column;} .about-engage-actions > *{width:100%;text-align:center;} .value-card,.model-card,.ecosystem-about-card{padding:20px;} }
</style>
