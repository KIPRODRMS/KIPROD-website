---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CapabilityPlatformLink from "../../components/CapabilityPlatformLink.astro";
import AnimatedCounter from "../components/AnimatedCounter.astro";
---

<BaseLayout
  title="Resources – KIPROD"
  description="Institutional resources and publications."
  activePath="/resources"
>

<section class="page-header">

  <div class="section-inner">

    <div class="section-tag">
      Knowledge Centre
    </div>

    <h1 class="section-heading">
      Resources &
      <em>Institutional Publications</em>
    </h1>

    <p class="section-sub">
      Executive guides, governance frameworks, institutional capability
      resources, implementation toolkits and research supporting stronger
      financial institutions.
    </p>

  </div>

</section>

<section class="about">

<div class="section-inner">

<div class="featured-resource reveal">

<div class="featured-badge">

Featured Resource

</div>

<h2>

KIPROD Company Profile

</h2>

<p>

Discover KIPROD's institutional engagement methodology,
governance philosophy,
Academy,
RMS,
Command Centre
and implementation approach.

</p>

<a
href="/downloads/company-profile.pdf"
class="btn-primary">

Download Company Profile →

</a>

</div>

</div>

</section>

<section class="featured-resource reveal">

  <div class="section-inner">

    <div class="featured-resource-card">

      <div class="featured-left">

        <div class="pill">
          Featured Resource
        </div>

        <h2>
          Institutional Capability Assessment Guide
        </h2>

        <p>
          Learn how KIPROD guides institutions through capability
          discovery, governance assessment, executive learning and
          implementation using our structured seven-stage institutional
          methodology.
        </p>

        <div class="featured-actions">

          <a
            href="/downloads/company-profile.pdf"
            class="btn-primary"
          >
            Download Company Profile →
          </a>

          <a
            href="/contact"
            class="btn-secondary"
          >
            Request Institutional Brief →
          </a>

        </div>

      </div>

      <div class="featured-right">

        <div class="featured-stat">

          <span class="number">7</span>

          <span class="label">
            Institutional Framework Stages
          </span>

        </div>

        <div class="featured-stat">

          <span class="number">3</span>

          <span class="label">
            Capability Platforms
          </span>

        </div>

        <div class="featured-stat">

          <span class="number">100%</span>

          <span class="label">
            Institution-Centred Methodology
          </span>

        </div>

      </div>

    </div>

  </div>

</section>

<section class="resource-nav">
  <div class="section-inner">

    <div class="resource-nav-grid">

      <a href="#corporate" class="resource-nav-card">
        <span>🏢</span>
        <h4>Corporate</h4>
        <p>Company profile & methodology</p>
      </a>

      <a href="#executive" class="resource-nav-card">
        <span>📑</span>
        <h4>Executive Briefs</h4>
        <p>Governance publications</p>
      </a>
    </div>

  </div>
</section>

<section
id="corporate"
class="about">

<div class="section-inner">

<div class="section-tag">
Corporate Resources
</div>

<h2 class="section-heading">

Institutional
<em>Documents</em>

</h2>

<p class="section-sub">

Essential documents introducing
KIPROD and its institutional ecosystem.

</p>

<div class="resource-grid">

<div class="resource-card reveal">

  <div class="resource-top">

    <div class="pill">
      Corporate
    </div>

    <span class="resource-type">
      📄 PDF
    </span>

  </div>

  <h3>
    Company Profile
  </h3>

  <p>
    Overview of KIPROD services, institutional methodology,
    implementation approach and the institutional ecosystem.
  </p>

  <div class="resource-meta">

    <span>12 Pages</span>

    <span>Updated 2026</span>

  </div>

  <a
    href="/downloads/company-profile.pdf"
    class="resource-link"
  >
    Download Resource →
  </a>

</div>

<div class="resource-card reveal">

  <div class="resource-top">

    <div class="pill">
      Framework
    </div>

    <span class="resource-type">
      Soon
    </span>

  </div>

  <h3>
    Institutional Methodology
  </h3>

  <p>
    Understanding ILCA, ICDF, ICAR and the KIPROD
    institutional strengthening framework.
  </p>

  <div class="resource-meta">

    <span>Framework</span>

    <span>Coming Soon</span>

  </div>

  <a
    class="resource-link disabled"
  >
    Coming Soon →
  </a>

</div>

<div class="resource-card reveal">

  <div class="resource-top">

    <div class="pill">
      Governance
    </div>

    <span class="resource-type">
      Guide
    </span>

  </div>

  <h3>
    Governance Framework
  </h3>

  <p>
    Practical governance principles supporting board oversight,
    executive accountability and institutional resilience.
  </p>

  <div class="resource-meta">

    <span>Executive Guide</span>

    <span>Coming Soon</span>

  </div>

  <a
    class="resource-link disabled"
  >
    Coming Soon →
  </a>

</div> <!-- closes third .resource-card -->

</div> <!-- closes .resource-grid -->

</div> <!-- closes .section-inner -->

</section>

<!-- ===================================== -->



<!-- ===================================== -->

<section
id="academy"
class="about">

<!-- Your Academy section goes here -->

</section>

<!-- ===================================== -->



<!-- ===================================== -->



</BaseLayout>
