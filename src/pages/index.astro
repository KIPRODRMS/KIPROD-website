---
import BaseLayout from "../layouts/BaseLayout.astro";

import HeroSection from "../components/home/HeroSection.astro";
import WhyKiprod from "../components/home/WhyKiprod.astro";
import JourneySection from "../components/home/JourneySection.astro";
import EcosystemSection from "../components/home/EcosystemSection.astro";
import ImpactGallery from "../components/home/ImpactGallery.astro";
import TrustedInstitutions from "../components/TrustedInstitutions.astro";
import InsightsSection from "../components/home/InsightsSection.astro";
import FinalPositioningSection from "../components/home/FinalPositioningSection.astro";

import { getPublishedInsights } from "../lib/insights";

const featuredInsights = (await getPublishedInsights()).slice(0, 3);
---

<BaseLayout
  title="KIPROD – Strengthening Credit Risk. Building Resilient Institutions."
  description="KIPROD helps financial institutions understand capability gaps, strengthen governance, develop institutional capability, and support continuous performance improvement."
  activePath="/"
>

  <!-- ======================================================
       01 — HERO
       ====================================================== -->

  <HeroSection />


  <!-- ======================================================
       02 — WHO WE SERVE
       ====================================================== -->

  <section class="institutional-strip">

    <div class="section-inner">

      <div class="section-tag">
        Who we serve
      </div>

      <div class="institutional-list">

        <span>Banks</span>
        <span>SACCOs</span>
        <span>Microfinance</span>
        <span>Credit Providers</span>
        <span>Government & Regulators</span>
        <span>DFIs & Cooperatives</span>

      </div>

    </div>

  </section>


  <!-- ======================================================
       03 — THE KIPROD DIFFERENCE
       ====================================================== -->

  <WhyKiprod />


  <!-- ======================================================
       04 — HOW KIPROD WORKS
       ====================================================== -->

  <JourneySection />


  <!-- ======================================================
       05 — THE KIPROD ECOSYSTEM
       ====================================================== -->

  <EcosystemSection />


  <!-- ======================================================
       06 — CAPABILITY IN ACTION
       ====================================================== -->

  <section class="capability-action">

    <div class="section-inner">

      <div class="section-tag reveal">
        Capability in action
      </div>

      <h2 class="section-heading reveal">
        From Institutional
        <em>Insight to Action</em>
      </h2>

      <p class="section-sub reveal">
        KIPROD brings institutional capability to life through
        executive learning, institutional collaboration and
        operational strengthening.
      </p>

    </div>

  </section>

  <ImpactGallery />


  <!-- ======================================================
       07 — EXPERIENCE & INSTITUTIONAL RELEVANCE
       ====================================================== -->

  <section class="experience-section">

    <div class="section-inner">

      <div class="section-tag reveal">
        Experience & institutional relevance
      </div>

      <h2 class="section-heading reveal">
        Built Around the Realities of
        <em>Financial Institutions</em>
      </h2>

      <p class="section-sub reveal">
        KIPROD supports institutions across critical areas of
        governance, credit risk, capability development,
        institutional performance and strategic improvement.
      </p>


      <div class="experience-grid">

        <div class="experience-content reveal">

          <h3>
            Institutional capability areas
          </h3>

          <div class="capability-list">

            <div>
              Agricultural Finance & Value Chains
            </div>

            <div>
              SME & Enterprise Development
            </div>

            <div>
              Financial Product Development
            </div>

            <div>
              Credit Risk & Portfolio Strengthening
            </div>

            <div>
              Governance & Policy
            </div>

            <div>
              AI-Driven Credit Risk
            </div>

          </div>

          <a
            href="/institute"
            class="text-link"
          >
            Explore Institutional Experience →
          </a>

        </div>


        <div class="experience-proof reveal">

          <div class="proof-number">
            KIPROD
          </div>

          <p>
            Institutional strengthening built around
            evidence, capability and execution.
          </p>

          <a
            href="/about"
            class="btn-secondary"
          >
            About KIPROD →
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- ======================================================
       08 — LATEST INSIGHTS
       ====================================================== -->

  <InsightsSection
    insights={featuredInsights}
  />


  <!-- ======================================================
       09 — FINAL INSTITUTIONAL CTA
       ====================================================== -->

  <FinalPositioningSection />


</BaseLayout>


<style>

  /* ========================================================
     WHO WE SERVE
     ======================================================== */

  .institutional-strip {
    padding: 34px 0;
    background: var(--white);
    border-bottom: 1px solid rgba(9, 34, 74, .08);
  }

  .institutional-strip .section-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .institutional-strip .section-tag {
    margin: 0;
    white-space: nowrap;
  }

  .institutional-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px 28px;
  }

  .institutional-list span {
    color: var(--navy);
    font-size: .84rem;
    font-weight: 600;
  }


  /* ========================================================
     CAPABILITY INTRO
     ======================================================== */

  .capability-action {
    padding: 100px 0 42px;
    background: var(--cream);
  }


  /* ========================================================
     EXPERIENCE
     ======================================================== */

  .experience-section {
    padding: 110px 0;
    background: var(--white);
  }

  .experience-grid {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: 70px;
    margin-top: 58px;
    align-items: stretch;
  }

  .experience-content {
    padding-right: 20px;
  }

  .experience-content h3 {
    margin: 0 0 28px;
    color: var(--navy);
    font: 600 1.65rem/1.2 var(--font-display);
  }

  .capability-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid rgba(9, 34, 74, .12);
  }

  .capability-list div {
    padding: 18px 20px;
    border-bottom: 1px solid rgba(9, 34, 74, .12);
    color: var(--navy);
    font-size: .9rem;
    line-height: 1.5;
  }

  .capability-list div:nth-child(odd) {
    border-right: 1px solid rgba(9, 34, 74, .12);
  }

  .text-link {
    display: inline-flex;
    margin-top: 28px;
    color: var(--navy);
    font-weight: 700;
    text-decoration: none;
  }

  .text-link:hover {
    color: var(--gold);
  }

  .experience-proof {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px;
    background: var(--navy);
    color: var(--white);
  }

  .proof-number {
    color: var(--gold-light);
    font: 600 1rem/1 var(--font-mono);
    letter-spacing: .18em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .experience-proof p {
    max-width: 380px;
    margin: 0 0 30px;
    color: rgba(255,255,255,.76);
    font-size: 1.15rem;
    line-height: 1.75;
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 900px) {

    .institutional-strip .section-inner {
      display: block;
    }

    .institutional-strip .section-tag {
      margin-bottom: 20px;
    }

    .institutional-list {
      justify-content: flex-start;
    }

    .experience-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

  }

  @media (max-width: 600px) {

    .capability-list {
      grid-template-columns: 1fr;
    }

    .capability-list div:nth-child(odd) {
      border-right: 0;
    }

    .experience-proof {
      padding: 34px;
    }

  }

</style>