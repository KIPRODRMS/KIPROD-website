---
import BaseLayout from "../layouts/BaseLayout.astro";

import HeroSection from "../components/home/HeroSection.astro";
import WhyKiprod from "../components/home/WhyKiprod.astro";
import EcosystemSection from "../components/home/EcosystemSection.astro";
import ImpactGallery from "../components/home/ImpactGallery.astro";
import InsightsSection from "../components/home/InsightsSection.astro";
import FinalPositioningSection from "../components/home/FinalPositioningSection.astro";

import { getPublishedInsights } from "../lib/insights";

const featuredInsights = (await getPublishedInsights()).slice(0, 3);
---

<BaseLayout
  title="KIPROD â€“ Strengthening Credit Risk. Building Resilient Institutions."
  description="KIPROD helps financial institutions understand capability gaps, strengthen governance, develop institutional capability, and support continuous performance improvement."
  activePath="/"
>

  <!-- 01 â€” HERO -->
  <HeroSection />


  <!-- 02 â€” WHO WE SERVE -->
  <section class="institutional-strip">
    <div class="section-inner">

      <div class="section-tag">
        Who we serve
      </div>

      <div class="institutional-list">
        <span>Banks</span>
        <span>SACCOs</span>
        <span>Microfinance</span>
        <span>Credit Providers</span>
        <span>Government & Regulators</span>
        <span>DFIs & Cooperatives</span>
      </div>

    </div>
  </section>


  <!-- 03 â€” THE KIPROD DIFFERENCE -->
  <WhyKiprod />


  <!-- 04 â€” THE KIPROD ECOSYSTEM -->
  <EcosystemSection />


  <!-- 05 â€” CAPABILITY IN ACTION -->
  <ImpactGallery />


  <!-- 06 â€” EXPERIENCE & INSTITUTIONAL RELEVANCE -->
  <section class="experience-section">

    <div class="section-inner">

      <div class="section-tag reveal">
        Experience & institutional relevance
      </div>

      <h2 class="section-heading reveal">
        Built Around the Realities of
        <em>Financial Institutions</em>
      </h2>

      <p class="section-sub reveal">
        KIPROD supports institutions across critical areas of
        governance, credit risk, capability development,
        institutional performance and strategic improvement.
      </p>

      <div class="experience-grid">

        <div class="experience-content reveal">

          <h3>
            Institutional capability areas
          </h3>

          <div class="capability-list">

            <div>
              Agricultural Finance & Value Chains
            </div>

            <div>
              SME & Enterprise Development
            </div>

            <div>
              Financial Product Development
            </div>

            <div>
              Credit Risk & Portfolio Strengthening
            </div>

            <div>
              Governance & Policy
            </div>

            <div>
              AI-Driven Credit Risk
            </div>

          </div>

          <a
            href="/institute"
            class="text-link"
          >
            Explore Institutional Experience â†’
          </a>

        </div>


        <div class="experience-proof reveal">

          <div class="proof-number">
            KIPROD
          </div>

          <p>
            Institutional strengthening built around
            evidence, capability and execution.
          </p>

          <a
            href="/about"
            class="btn-secondary"
          >
            About KIPROD â†’
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- 07 â€” LATEST INSIGHTS -->
  <InsightsSection
    posts={featuredInsights}
  />


  <!-- 08 â€” FINAL INSTITUTIONAL CTA -->
  <FinalPositioningSection />

</BaseLayout>


<style>

  /* WHO WE SERVE */

  .institutional-strip {
    padding: 28px 0;
    background: var(--white);
    border-bottom: 1px solid rgba(9, 34, 74, .08);
  }

  .institutional-strip .section-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .institutional-strip .section-tag {
    margin: 0;
    white-space: nowrap;
  }

  .institutional-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px 24px;
  }

  .institutional-list span {
    color: var(--navy);
    font-size: .82rem;
    font-weight: 600;
  }


  /* EXPERIENCE */

  .experience-section {
    padding: 64px 0;
    background: var(--white);
  }

  .experience-grid {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: 42px;
    margin-top: 34px;
    align-items: stretch;
  }

  .experience-content {
    padding-right: 12px;
  }

  .experience-content h3 {
    margin: 0 0 22px;
    color: var(--navy);
    font: 600 1.55rem/1.2 var(--font-display);
  }

  .capability-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid rgba(9, 34, 74, .12);
  }

  .capability-list div {
    padding: 14px 18px;
    border-bottom: 1px solid rgba(9, 34, 74, .12);
    color: var(--navy);
    font-size: .88rem;
    line-height: 1.45;
  }

  .capability-list div:nth-child(odd) {
    border-right: 1px solid rgba(9, 34, 74, .12);
  }

  .text-link {
    display: inline-flex;
    margin-top: 24px;
    color: var(--navy);
    font-weight: 700;
    text-decoration: none;
  }

  .text-link:hover {
    color: var(--gold);
  }

  .experience-proof {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 36px;
    background: var(--navy);
    color: var(--white);
  }

  .proof-number {
    color: var(--gold-light);
    font: 600 1rem/1 var(--font-mono);
    letter-spacing: .18em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .experience-proof p {
    max-width: 380px;
    margin: 0 0 26px;
    color: rgba(255,255,255,.76);
    font-size: 1.08rem;
    line-height: 1.65;
  }


  /* RESPONSIVE */

  @media (max-width: 900px) {

    .institutional-strip .section-inner {
      display: block;
    }

    .institutional-strip .section-tag {
      margin-bottom: 16px;
    }

    .institutional-list {
      justify-content: flex-start;
    }

    .experience-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

  }


  @media (max-width: 600px) {

    .institutional-strip {
      padding: 24px 0;
    }

    .institutional-list {
      gap: 7px 18px;
    }

    .capability-list {
      grid-template-columns: 1fr;
    }

    .capability-list div:nth-child(odd) {
      border-right: 0;
    }

    .experience-section {
      padding: 56px 0;
    }

    .experience-proof {
      padding: 30px;
    }

  }

</style>
